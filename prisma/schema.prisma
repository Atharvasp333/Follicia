// This is your Prisma schema file
// Prisma 7+: datasource URL lives in prisma.config.ts (not here)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ──────────────────────────────────────────────────────────────────
// Stores core profile and Follicia-specific hair profiling data
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  // Follicia hair-profiling fields
  hairType       String?  // e.g. "straight", "wavy", "curly", "coily"
  porosity       String?  // e.g. "low", "medium", "high"
  scalpCondition String?  // e.g. "oily", "dry", "normal", "sensitive"
  // AI Hair DNA Analysis fields
  porosityScore  Int?     // 1-100: AI-calculated porosity metric
  scalpHealth    Int?     // 1-100: AI-calculated scalp health metric
  primaryConcern String?  // AI-identified main hair concern
  hairAnalysis   String?  // AI-generated clinical summary
  targetTags     String[] // AI-recommended product tags
  // Firebase authentication UID
  firebaseUid    String?  @unique
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders         Order[]
  cartItems      CartItem[]

  @@map("users")
}

// ─── Product ───────────────────────────────────────────────────────────────
// Hair & scalp products with AI matching metadata
model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?
  tagline        String?
  // Ingredient list stored as a JSON array of strings
  ingredients    String[] // e.g. ["Biotin", "Keratin", "Argan Oil"]
  price          Float
  priceDisplay   String?  // e.g. "₹2,490"
  imageUrl       String?
  // AI matching tag — used by the recommendation engine
  aiMatchTag     String?  // e.g. "dry-scalp", "frizz-control", "growth"
  category       String?
  // Hair profiling filter fields
  hairType       String[] // e.g. ["dry", "curly", "all"]
  porosity       String[] // e.g. ["low", "medium", "high"]
  scalpCondition String[] // e.g. ["dandruff", "frizz", "thinning"]
  badge          String?
  rating         Float    @default(0)
  reviews        Int      @default(0)
  stock          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@map("products")
}

// ─── Order ─────────────────────────────────────────────────────────────────
model Order {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  status                OrderStatus @default(PENDING)
  totalAmount           Float
  shippingMethod        String?     // "standard" or "express"
  shippingCost          Float       @default(0)
  // Shipping address
  shippingName          String?
  shippingEmail         String?
  shippingPhone         String?
  shippingAddress       String?
  shippingCity          String?
  shippingState         String?
  shippingPincode       String?
  // Razorpay payment tracking
  razorpayOrderId       String?
  razorpayPaymentId     String?
  // Razorpay invoice tracking
  razorpayInvoiceId     String?
  invoiceUrl            String?
  invoiceGeneratedAt    DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items                 OrderItem[]

  @@map("orders")
}

// ─── OrderItem ─────────────────────────────────────────────────────────────
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@map("order_items")
}

// ─── CartItem ──────────────────────────────────────────────────────────────
// Persistent cart items for authenticated users
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("cart_items")
}

// ─── Enums ─────────────────────────────────────────────────────────────────
enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}
