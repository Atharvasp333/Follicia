// This is your Prisma schema file
// Prisma 7+: datasource URL lives in prisma.config.ts (not here)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ──────────────────────────────────────────────────────────────────
// Stores core profile and Follicia-specific hair profiling data
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  // Follicia hair-profiling fields
  hairType       String?  // e.g. "straight", "wavy", "curly", "coily"
  porosity       String?  // e.g. "low", "medium", "high"
  scalpCondition String?  // e.g. "oily", "dry", "normal", "sensitive"
  // Optional Clerk link (populated after auth setup)
  clerkId        String?  @unique
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders         Order[]

  @@map("users")
}

// ─── Product ───────────────────────────────────────────────────────────────
// Hair & scalp products with AI matching metadata
model Product {
  id           String   @id @default(cuid())
  name         String
  description  String?
  // Ingredient list stored as a JSON array of strings
  ingredients  String[] // e.g. ["Biotin", "Keratin", "Argan Oil"]
  price        Float
  imageUrl     String?
  // AI matching tag — used by the recommendation engine
  aiMatchTag   String?  // e.g. "dry-scalp", "frizz-control", "growth"
  category     String?
  stock        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems   OrderItem[]

  @@map("products")
}

// ─── Order ─────────────────────────────────────────────────────────────────
model Order {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  status                OrderStatus @default(PENDING)
  totalAmount           Float
  stripePaymentIntentId String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items                 OrderItem[]

  @@map("orders")
}

// ─── OrderItem ─────────────────────────────────────────────────────────────
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@map("order_items")
}

// ─── Enums ─────────────────────────────────────────────────────────────────
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
