// This is your Prisma schema file
// Prisma 7+: datasource URL lives in prisma.config.ts (not here)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ──────────────────────────────────────────────────────────────────
// Stores core profile and Follicia-specific hair profiling data
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  // Follicia hair-profiling fields
  hairType       String?  // e.g. "straight", "wavy", "curly", "coily"
  porosity       String?  // e.g. "low", "medium", "high"
  scalpCondition String?  // e.g. "oily", "dry", "normal", "sensitive"
  // AI Hair DNA Analysis fields
  porosityScore  Int?     // 1-100: AI-calculated porosity metric
  scalpHealth    Int?     // 1-100: AI-calculated scalp health metric
  primaryConcern String?  // AI-identified main hair concern
  hairAnalysis   String?  // AI-generated clinical summary
  targetTags     String[] // AI-recommended product tags
  // Firebase authentication UID
  firebaseUid    String?  @unique
  imageUrl       String?
  // Membership plan
  plan           String?  // "bronze", "silver", "gold"
  planName       String?  // "Bronze", "Silver", "Gold"
  // Loyalty Points
  loyaltyPoints  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders              Order[]
  cartItems           CartItem[]
  quizResults         QuizResult[]
  loyaltyTransactions LoyaltyTransaction[]
  redeemedCoupons     UserCoupon[]

  @@map("users")
}

// ─── Product ───────────────────────────────────────────────────────────────
// Hair & scalp products with AI matching metadata
model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?
  tagline        String?
  // Ingredient list stored as a JSON array of strings
  ingredients    String[] // e.g. ["Biotin", "Keratin", "Argan Oil"]
  price          Float
  priceDisplay   String?  // e.g. "₹2,490"
  imageUrl       String?
  // AI matching tag — used by the recommendation engine
  aiMatchTag     String?  // e.g. "dry-scalp", "frizz-control", "growth"
  category       String?
  // Hair profiling filter fields
  hairType       String[] // e.g. ["dry", "curly", "all"]
  porosity       String[] // e.g. ["low", "medium", "high"]
  scalpCondition String[] // e.g. ["dandruff", "frizz", "thinning"]
  badge          String?
  rating         Float    @default(0)
  reviews        Int      @default(0)
  stock          Int      @default(0)
  inventoryCount Int      @default(0)
  lowStockThreshold Int   @default(5)
  isActive       Boolean  @default(true)
  // Product interaction tracking for analytics (lifetime totals)
  viewsCount     Int      @default(0)
  addToCartCount Int      @default(0)
  purchaseCount  Int      @default(0)
  cancelCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems     OrderItem[]
  cartItems      CartItem[]
  events         ProductEvent[]

  @@map("products")
}

// ─── ProductEvent ──────────────────────────────────────────────────────────
// Event log for time-based product analytics
model ProductEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String   // "VIEW", "CART", "PURCHASE", "CANCEL"
  createdAt DateTime @default(now())

  @@index([productId, type, createdAt])
  @@map("product_events")
}

// ─── Order ─────────────────────────────────────────────────────────────────
model Order {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  status                OrderStatus @default(PENDING)
  totalAmount           Float
  shippingMethod        String?     // "standard" or "express"
  shippingCost          Float       @default(0)
  // Coupon/discount tracking
  couponId              String?
  coupon                RewardCoupon? @relation(fields: [couponId], references: [id])
  discountAmount        Float       @default(0)
  // Shipping address
  shippingName          String?
  shippingEmail         String?
  shippingPhone         String?
  shippingAddress       String?
  shippingCity          String?
  shippingState         String?
  shippingPincode       String?
  // Razorpay payment tracking
  razorpayOrderId       String?
  razorpayPaymentId     String?
  // Razorpay invoice tracking
  razorpayInvoiceId     String?
  invoiceUrl            String?
  invoiceGeneratedAt    DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items                 OrderItem[]

  @@map("orders")
}

// ─── OrderItem ─────────────────────────────────────────────────────────────
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@map("order_items")
}

// ─── CartItem ──────────────────────────────────────────────────────────────
// Persistent cart items for authenticated users
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("cart_items")
}

// ─── QuizResult ────────────────────────────────────────────────────────────
// Stores a user's raw quiz answers, AI diagnostic result, and hair goal
model QuizResult {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Submitted answers stored as raw JSON
  answers          Json?
  // AI-generated diagnostic label e.g. "High Porosity Repair"
  diagnosticResult String?
  // User-stated hair goal e.g. "Density Amplification"
  hairGoal         String?
  // Whether the AI has finished processing this submission
  analyzed         Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@map("quiz_results")
}

// ─── LoyaltyTransaction ────────────────────────────────────────────────────
// Tracks all loyalty points earned and redeemed by users
model LoyaltyTransaction {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int                 // Positive for EARNED, negative for REDEEMED
  type        LoyaltyTransactionType
  description String
  createdAt   DateTime            @default(now())

  @@index([userId, createdAt])
  @@map("loyalty_transactions")
}

// ─── RewardCoupon ──────────────────────────────────────────────────────────
// Redeemable coupons that users can claim with loyalty points
model RewardCoupon {
  id             String       @id @default(cuid())
  code           String       @unique
  discountAmount Float        // Discount value in currency
  pointsRequired Int          // Points needed to redeem
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  userCoupons    UserCoupon[]
  orders         Order[]      // Orders that used this coupon

  @@map("reward_coupons")
}

// ─── UserCoupon ────────────────────────────────────────────────────────────
// Join table tracking which coupons users have redeemed
model UserCoupon {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId  String
  coupon    RewardCoupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  redeemedAt DateTime     @default(now())

  @@unique([userId, couponId])
  @@index([userId])
  @@map("user_coupons")
}

// ─── Enums ─────────────────────────────────────────────────────────────────
enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
}
